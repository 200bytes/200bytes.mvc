@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Software Architecture and Back End Development Services Stockport, United Kingdom">
    <title>200 Bytes</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=BioRhyme&family=Libre+Baskerville&display=swap" as="style" onload="this.rel='stylesheet'">
    <link rel="stylesheet" href="~/css/home.css">
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BioRhyme&family=Libre+Baskerville&display=swap">
    </noscript>
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebSite",
            "publisher": {
                "@@type": "Organization",
                "name": "200 Bytes Ltd",
                "logo": {
                    "@@type": "ImageObject",
                    "url": "https://200bytes.com/favicon.ico",
                    "width": 32,
                    "height": 32
                }
            },
            "url": "https://200bytes.com",
            "mainEntityOfPage": {
                "@@type": "WebPage",
                "@@id": "https://200bytes.com"
            },
            "description": "Software Architecture and Back End Development Services Stockport, United Kingdom"
        }
    </script>
</head>
<body>
    <div class="content">
        <div class="tree">
            <img src="~/images/tree.svg" alt="200 Bytes tree logo">
        </div>
        <h1 class="title"><strong>200 Bytes</strong></h1>
        <p>200 Bytes is a digital consultancy that offers expert software architecture and web development services</p>
        <p class="enquiries">
            <img src="~/images/envelope.svg" alt="">
            <strong>Enquiries</strong>
        </p>
        <p class="contact">
            <a href="mailto:enquiries@200bytes.com">enquiries@200bytes.com</a>
        </p>
        <footer>
            <p>&copy; 200 Bytes Ltd Company no. 13862404</p>
        </footer>
    </div>
</body>
</html>
